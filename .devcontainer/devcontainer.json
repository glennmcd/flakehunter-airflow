{
  "name": "flakehunter-airflow",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "remoteEnv": {
    "AIRFLOW_HOME": "${containerWorkspaceFolder}/.airflow",
    "AIRFLOW__CORE__DAGS_FOLDER": "${containerWorkspaceFolder}/dags",
    "AIRFLOW__CORE__LOAD_EXAMPLES": "False",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/install.sh",
  "postAttachCommand": "bash .devcontainer/start-airflow.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Airflow UI",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
